{"id":"ce757b072f4dcdaf5679","cop":"Layout/FirstMethodArgumentLineBreak","selection":"Layout/FirstMethodArgumentLineBreak","source":"# frozen_string_literal: true\n\nclass ApplicationJob < ActiveJob::Base\n  include SemanticLogger::Loggable\n\n  PRIORITIES = ActiveSupport::OrderedOptions[{\n    push: 1,\n    download: 2,\n    web_hook: 3,\n    profile_deletion: 3,\n    stats: 4\n  }].freeze\n\n  # Default to retrying errors a few times, so we don't get an alert for\n  # spurious errors\n  retry_on StandardError, wait: :polynomially_longer, attempts: 5\n\n  # Automatically retry jobs that encountered a deadlock\n  retry_on ActiveRecord::Deadlocked\n\n  # Most jobs are safe to ignore if the underlying records are no longer available\n  # discard_on ActiveJob::DeserializationError\n\n  after_discard do |job, exception|\n    tags = job.statsd_tags.merge(\n      exception: exception.class.name,\n      adapter: job.class.queue_adapter.class.name\n    )\n    StatsD.increment(\"good_job.discarded\", tags: tags)\n  end\nend\n","path":"app/jobs/application_job.rb","ruby_version":"3.4","parser_engine":"parser_prism","external_encoding":"UTF-8","internal_encoding":null,"file_mode":null,"config":"59dc048e49ce8f6f","diagnostics":[],"autocorrect_checked":false,"autocorrect_all":null,"autocorrect_all_error":null,"autocorrect_safe":null,"autocorrect_safe_error":null,"origins":[{"kind":"legacy_project","repository":"rubygems/rubygems.org","revision":"3201f8831866f82eb9acd7f66287a978d0e59079","path":"app/jobs/application_job.rb"}]}
