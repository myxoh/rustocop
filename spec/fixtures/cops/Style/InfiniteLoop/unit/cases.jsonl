{"id":"dd5907c8762535d91dcd","cop":"Style/InfiniteLoop","selection":"Style/InfiniteLoop","source":"def invoke\n  callback = proc do\n    while true\n      current = next_item\n      break current\n    end\n  end\n  callback.call\nend\n\ndef unrelated(current)\n  current\nend\n\ndef leaking_value\n  while true\n    suffix = next_item\n    break\n  end\n  use(suffix)\nend\n\ndef nested_block_local(rows)\n  while true\n    rows.each do |row|\n      id = row.id\n      use(id)\n    end\n    break\n  end\n  rows.each { |row| use(row.id) }\nend\n","path":"activesupport/lib/active_support/callbacks.rb","ruby_version":"3.4","parser_engine":"parser_prism","external_encoding":"UTF-8","internal_encoding":null,"file_mode":null,"config":"59dc048e49ce8f6f","diagnostics":[{"message":"Use `Kernel#loop` for infinite loops.","severity":"convention","correctable":true,"line":3,"column":5,"last_line":3,"last_column":9},{"message":"Use `Kernel#loop` for infinite loops.","severity":"convention","correctable":true,"line":24,"column":3,"last_line":24,"last_column":7}],"autocorrect_checked":true,"autocorrect_all":"def invoke\n  callback = proc do\n    loop do\n      current = next_item\n      break current\n    end\n  end\n  callback.call\nend\n\ndef unrelated(current)\n  current\nend\n\ndef leaking_value\n  while true\n    suffix = next_item\n    break\n  end\n  use(suffix)\nend\n\ndef nested_block_local(rows)\n  loop do\n    rows.each do |row|\n      id = row.id\n      use(id)\n    end\n    break\n  end\n  rows.each { |row| use(row.id) }\nend\n","autocorrect_all_error":null,"autocorrect_safe":null,"autocorrect_safe_error":null,"origins":[{"kind":"legacy_project","repository":"rails/rails","revision":"ba4f7369aee71f9f38d67bdbf0e8571fb372b535","path":"activesupport/lib/active_support/callbacks.rb"}]}
