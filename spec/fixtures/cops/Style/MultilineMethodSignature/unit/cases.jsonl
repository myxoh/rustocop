{"id":"b2403ffce71c9b710185","cop":"Style/MultilineMethodSignature","selection":"Style/MultilineMethodSignature","source":"# frozen_string_literal: true\n\nrequire 'test_file_finder'\nrequire_relative 'helpers/predictive_tests_helper'\n\nmodule Tooling\n  class FindTests\n    include Helpers::PredictiveTestsHelper\n\n    def initialize(\n      changed_files,\n      mappings_file: nil,\n      mappings_limit_percentage: nil\n    )\n      @changed_files = changed_files\n      @mappings_file = mappings_file\n      @mappings_limit_percentage = mappings_limit_percentage\n    end\n\n    def execute\n      tff = TestFileFinder::FileFinder.new(paths: changed_files).tap do |file_finder|\n        if mappings_file && !mappings_file.empty?\n          file_finder.use TestFileFinder::MappingStrategies::DirectMatching.load_json(\n            mappings_file,\n            limit_percentage: mappings_limit_percentage,\n            limit_min: 14\n          )\n        end\n\n        file_finder.use TestFileFinder::MappingStrategies::PatternMatching.load('tests.yml')\n      end\n\n      tff.test_files.select { |file| file.end_with?('_spec.rb') }.uniq\n    end\n\n    private\n\n    attr_reader :changed_files, :mappings_file, :mappings_limit_percentage\n  end\nend\n","path":"tooling/lib/tooling/find_tests.rb","ruby_version":"3.4","parser_engine":"parser_prism","external_encoding":"UTF-8","internal_encoding":null,"file_mode":null,"config":"59dc048e49ce8f6f","diagnostics":[{"message":"Avoid multi-line method signatures.","severity":"convention","correctable":true,"line":10,"column":5,"last_line":18,"last_column":7}],"autocorrect_checked":true,"autocorrect_all":"# frozen_string_literal: true\n\nrequire 'test_file_finder'\nrequire_relative 'helpers/predictive_tests_helper'\n\nmodule Tooling\n  class FindTests\n    include Helpers::PredictiveTestsHelper\n\n    def initialize(changed_files, mappings_file: nil, mappings_limit_percentage: nil)\n      @changed_files = changed_files\n      @mappings_file = mappings_file\n      @mappings_limit_percentage = mappings_limit_percentage\n    end\n\n    def execute\n      tff = TestFileFinder::FileFinder.new(paths: changed_files).tap do |file_finder|\n        if mappings_file && !mappings_file.empty?\n          file_finder.use TestFileFinder::MappingStrategies::DirectMatching.load_json(\n            mappings_file,\n            limit_percentage: mappings_limit_percentage,\n            limit_min: 14\n          )\n        end\n\n        file_finder.use TestFileFinder::MappingStrategies::PatternMatching.load('tests.yml')\n      end\n\n      tff.test_files.select { |file| file.end_with?('_spec.rb') }.uniq\n    end\n\n    private\n\n    attr_reader :changed_files, :mappings_file, :mappings_limit_percentage\n  end\nend\n","autocorrect_all_error":null,"autocorrect_safe":"$all","autocorrect_safe_error":null,"origins":[{"kind":"legacy_project","repository":"gitlabhq/gitlabhq","revision":"67a526442c20d20b6e80ebf916bd766b54018c5e","path":"tooling/lib/tooling/find_tests.rb"}]}
