{"id":"69ea503d5114a4b4178c","cop":"Lint/NonAtomicFileOperation","selection":"Lint/NonAtomicFileOperation","source":"\n    # Marks a TODO YAML file for inspection by renaming the original TODO YAML\n    # and appending the suffix +.inspect+ to it.\n    #\n    # @return [Boolean] +true+ a file was marked for inspection successfully.\n    def inspect(cop_name)\n      path = path_for(cop_name)\n\n      if File.exist?(path)\n        FileUtils.mv(path, \"#{path}#{SUFFIX_INSPECT}\")\n        true\n      else\n        false\n      end\n    end\n\n    # Marks all TODO YAML files for inspection.\n","path":"rubocop/todo_dir.rb","ruby_version":"3.4","parser_engine":"parser_prism","external_encoding":"UTF-8","internal_encoding":null,"file_mode":null,"config":"59dc048e49ce8f6f","diagnostics":[],"autocorrect_checked":true,"autocorrect_all":null,"autocorrect_all_error":null,"autocorrect_safe":null,"autocorrect_safe_error":null,"origins":[{"kind":"legacy_project","repository":"gitlabhq/gitlabhq","revision":"67a526442c20d20b6e80ebf916bd766b54018c5e","path":"rubocop/todo_dir.rb"}]}
