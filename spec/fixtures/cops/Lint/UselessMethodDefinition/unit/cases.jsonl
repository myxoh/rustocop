{"id":"9d2ce15a1107ab1b423b","cop":"Lint/UselessMethodDefinition","selection":"Lint/UselessMethodDefinition","source":"# frozen_string_literal: true\n\nmodule AvoAuditable\n  extend ActiveSupport::Concern\n\n  prepended do\n    include Auditable\n\n    prepend_around_action :unscope_users\n  end\n\n  def perform_action_and_record_errors(&blk)\n    super do\n      action = params.fetch(:action)\n      fields = action == \"destroy\" ? {} : cast_nullable(model_params)\n\n      @record.errors.add :comment, \"must supply a sufficiently detailed comment\" if fields[:comment]&.then { it.length < 10 }\n      raise ActiveRecord::RecordInvalid, @record if @record.errors.present?\n      action_name = \"Manual #{action} of #{@record.class}\"\n\n      value, @audit = in_audited_transaction(\n        auditable: @record,\n        admin_github_user: _current_user,\n        action: action_name,\n        fields: fields.reverse_merge(comment: action_name),\n        arguments: {},\n        models: [@record],\n        &blk\n      )\n      value\n    end\n  end\n\n  def after_update_path\n    return avo.resources_audit_path(@audit) if @audit.present?\n\n    super\n  end\n\n  def after_create_path\n    return avo.resources_audit_path(@audit) if @audit.present?\n\n    super\n  end\n\n  def unscope_users(&)\n    User.unscoped(&)\n  end\nend\n","path":"app/controllers/concerns/avo_auditable.rb","ruby_version":"3.4","parser_engine":"parser_prism","external_encoding":"UTF-8","internal_encoding":null,"file_mode":null,"config":"59dc048e49ce8f6f","diagnostics":[],"autocorrect_checked":false,"autocorrect_all":null,"autocorrect_all_error":null,"autocorrect_safe":null,"autocorrect_safe_error":null,"origins":[{"kind":"legacy_project","repository":"rubygems/rubygems.org","revision":"3201f8831866f82eb9acd7f66287a978d0e59079","path":"app/controllers/concerns/avo_auditable.rb"}]}
