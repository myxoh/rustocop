{"id":"00805ff98447c0ed70ef","cop":"Lint/ConstantDefinitionInBlock","selection":"Lint/ConstantDefinitionInBlock","source":"# frozen_string_literal: true\n\nrequire_relative \"xml_mini_engine_test\"\n\nXMLMiniEngineTest.run_with_platform(\"java\") do\n  class JDOMEngineTest < XMLMiniEngineTest\n    FILES_DIR = File.expand_path(\"../fixtures/xml\", __dir__)\n\n    def test_not_allowed_to_expand_entities_to_files\n      attack_xml = <<-EOT\n      <!DOCTYPE member [\n        <!ENTITY a SYSTEM \"file://#{FILES_DIR}/jdom_include.txt\">\n      ]>\n      <member>x&a;</member>\n      EOT\n      assert_equal \"x\", Hash.from_xml(attack_xml)[\"member\"]\n    end\n\n    def test_not_allowed_to_expand_parameter_entities_to_files\n      attack_xml = <<-EOT\n      <!DOCTYPE member [\n        <!ENTITY % b SYSTEM \"file://#{FILES_DIR}/jdom_entities.txt\">\n        %b;\n      ]>\n      <member>x&a;</member>\n      EOT\n      assert_raise Java::OrgXmlSax::SAXParseException do\n        assert_equal \"x\", Hash.from_xml(attack_xml)[\"member\"]\n      end\n    end\n\n    def test_not_allowed_to_load_external_doctypes\n      attack_xml = <<-EOT\n      <!DOCTYPE member SYSTEM \"file://#{FILES_DIR}/jdom_doctype.dtd\">\n      <member>x&a;</member>\n      EOT\n      assert_equal \"x\", Hash.from_xml(attack_xml)[\"member\"]\n    end\n\n    private\n      def engine\n        \"JDOM\"\n      end\n\n      def expansion_attack_error\n        Java::OrgXmlSax::SAXParseException\n      end\n\n      def extended_engine?\n        false\n      end\n  end\nend\n","path":"activesupport/test/xml_mini/jdom_engine_test.rb","ruby_version":"3.4","parser_engine":"parser_prism","external_encoding":"UTF-8","internal_encoding":null,"file_mode":null,"config":"59dc048e49ce8f6f","diagnostics":[{"message":"Do not define constants this way within a block.","severity":"warning","correctable":false,"line":6,"column":3,"last_line":52,"last_column":5}],"autocorrect_checked":true,"autocorrect_all":null,"autocorrect_all_error":null,"autocorrect_safe":null,"autocorrect_safe_error":null,"origins":[{"kind":"legacy_project","repository":"rails/rails","revision":"ba4f7369aee71f9f38d67bdbf0e8571fb372b535","path":"activesupport/test/xml_mini/jdom_engine_test.rb"}]}
