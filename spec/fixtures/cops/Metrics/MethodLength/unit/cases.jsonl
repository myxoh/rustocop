{"id":"d8ab936c37a1b4dcc330","cop":"Metrics/MethodLength","selection":"Metrics/MethodLength","source":"# frozen_string_literal: true\n\nclass AccountBuilder\n  include CustomExceptions::Account\n  pattr_initialize [:account_name, :email!, :confirmed, :user, :user_full_name, :user_password, :super_admin, :locale]\n\n  def perform\n    if @user.nil?\n      validate_email\n      validate_user\n    end\n    ActiveRecord::Base.transaction do\n      @account = create_account\n      @user = create_and_link_user\n    end\n    [@user, @account]\n  rescue StandardError => e\n    Rails.logger.debug e.inspect\n    raise e\n  end\n\n  private\n\n  def user_full_name\n    # the empty string ensures that not-null constraint is not violated\n    @user_full_name || ''\n  end\n\n  def account_name\n    # the empty string ensures that not-null constraint is not violated\n    @account_name || ''\n  end\n\n  def validate_email\n    Account::SignUpEmailValidationService.new(@email).perform\n  end\n\n  def validate_user\n    if User.exists?(email: @email)\n      raise UserExists.new(email: @email)\n    else\n      true\n    end\n  end\n\n  def create_account\n    @account = Account.create!(\n      name: account_name,\n      locale: I18n.locale,\n      custom_attributes: { 'onboarding_step' => 'account_details' }\n    )\n    Current.account = @account\n  end\n\n  def create_and_link_user\n    if @user.present? || create_user\n      link_user_to_account(@user, @account)\n      @user\n    else\n      raise UserErrors.new(errors: @user.errors)\n    end\n  end\n\n  def link_user_to_account(user, account)\n    AccountUser.create!(\n      account_id: account.id,\n      user_id: user.id,\n      role: AccountUser.roles['administrator']\n    )\n  end\n\n  def create_user\n    @user = User.new(email: @email,\n                     password: user_password,\n                     password_confirmation: user_password,\n                     name: user_full_name)\n    @user.type = 'SuperAdmin' if @super_admin\n    @user.confirm if @confirmed\n    @user.save!\n  end\nend\n","path":"app/builders/account_builder.rb","ruby_version":"3.4","parser_engine":"parser_prism","external_encoding":"UTF-8","internal_encoding":null,"file_mode":null,"config":"6f1616c5ef015896","diagnostics":[{"message":"Method has too many lines. [12/10]","severity":"convention","correctable":false,"line":7,"column":3,"last_line":20,"last_column":5}],"autocorrect_checked":false,"autocorrect_all":null,"autocorrect_all_error":null,"autocorrect_safe":null,"autocorrect_safe_error":null,"origins":[{"kind":"project_isolation","direction":"rubocop_only","repository":"chatwoot/chatwoot","revision":"8d93d69e8e356216e85c28de7c4240e66b8e83fa","path":"app/builders/account_builder.rb","line":7},{"kind":"project_isolation","direction":"rustocop_only","repository":"chatwoot/chatwoot","revision":"8d93d69e8e356216e85c28de7c4240e66b8e83fa","path":"app/builders/account_builder.rb","line":7}]}
